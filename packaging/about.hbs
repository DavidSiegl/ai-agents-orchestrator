<!DOCTYPE html>
<!-- cargo-about's template for dist/octoflow-third-party-licenses.html (packaging/about.toml). -->
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Octoflow AI: third-party licenses</title>
    <style>
        :root { color-scheme: light dark; }
        body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
        pre { white-space: pre-wrap; padding: 1rem; border: 1px solid #8884; border-radius: 4px; font-size: 0.85rem; }
        .used-by { columns: 16rem; padding-left: 1.2rem; }
    </style>
</head>
<body>
    <h1>Third-party licenses</h1>
    <p>
        The Octoflow AI orchestrator and desktop app contain the following Rust crates, under the licenses below.
        Octoflow AI itself is licensed under MIT OR Apache-2.0.
    </p>

    <h2>Overview</h2>
    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
        {{/each}}
    </ul>

    <h2>License texts</h2>
    {{#each licenses}}
    <section>
        <h3{{#if first_of_kind}} id="{{id}}"{{/if}}>{{name}}</h3>
        <p>Used by:</p>
        <ul class="used-by">
            {{#each used_by}}
            <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
            {{/each}}
        </ul>
        <pre>{{text}}</pre>
    </section>
    {{/each}}
</body>
</html>
